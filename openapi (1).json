  "paths": {
    "/createexcel": {
      "post": {
        "operationId": "CreateExcel",
        "summary": "Create an Excel workbook",
        "description": "Builds a professionally formatted workbook (tables, formulas, KPI cards, summaries, charts, conditional formatting, dropdowns, dashboards) from a sheet specification and returns a download link.",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "sheets"
              ],
              "properties": {
                "fileName": {
                  "type": "string",
                  "x-ms-summary": "File name",
                  "description": "Name for the workbook, without extension"
                },
                "theme": {
                  "type": "string",
                  "x-ms-summary": "Theme",
                  "description": "vkollab (default blue), slate, green or orange",
                  "default": "vkollab"
                },
                "currency": {
                  "type": "string",
                  "x-ms-summary": "Currency",
                  "description": "USD, INR, EUR, GBP, JPY, AUD or CAD. Used by 'currency' number formats.",
                  "default": "USD"
                },
                "sheets": {
                  "type": "array",
                  "x-ms-summary": "Sheets",
                  "items": {
                    "type": "object"
                  },
                  "description": "List of sheet objects. Each: {name, blocks:[...]} where blocks are title, kpis, table, summary, chart, text, spacer. Shorthand per sheet also works: {name, title, subtitle, kpis, headers, rows, columns, totalRow, summaries, charts, notes}. Formulas are strings starting with '='; use [@Column] for same-row cells and Table[Column] for a whole column. Call GetExcelCapabilities for the full list."
                },
                "returnBase64": {
                  "type": "boolean",
                  "x-ms-summary": "Return file content",
                  "description": "Also return the file as base64 (files up to 4 MB)",
                  "default": false
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "description": "success or error"
                },
                "fileName": {
                  "type": "string",
                  "description": "Name of the generated workbook"
                },
                "downloadUrl": {
                  "type": "string",
                  "description": "Link the user can click to download the workbook. Always share this link."
                },
                "sheetCount": {
                  "type": "integer"
                },
                "sheets": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Sheet names in the result"
                },
                "changes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Plain-language log of what was done"
                },
                "warnings": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Things the user should know. Always mention these."
                },
                "preservationWarnings": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Features of the original file that could not be kept"
                },
                "formulasVerified": {
                  "type": "boolean",
                  "description": "True only if formula results were checked on the server. If false, Excel calculates them on open."
                },
                "report": {
                  "type": "object",
                  "description": "Validation results when validate_data was used"
                },
                "sourceFormat": {
                  "type": "string"
                },
                "errorCode": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
