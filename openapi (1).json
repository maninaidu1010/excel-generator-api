    "/analyzeexcel": {
      "post": {
        "operationId": "AnalyzeExcel",
        "summary": "Inspect and validate an Excel workbook",
        "description": "Reads a workbook without changing it: structure, detected data range, column profile, formula errors, data-quality problems, health score, suggestions and features that editing could lose. Always call this before editing a file you have not seen.",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "body",
