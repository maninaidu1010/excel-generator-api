    "/excel-capabilities": {
      "get": {
        "operationId": "GetExcelCapabilities",
        "summary": "List Excel features and operations",
        "description": "Returns every operation, block, chart type, conditional-format type and number format the Excel tools support.",
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "schema": {
              "type": "object",
              "properties": {
                "operations": {
                  "type": "object",
                  "description": "Operation names with their parameters"
                },
                "chartTypes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "blocks": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
