    "/editexcel": {
      "post": {
        "operationId": "EditExcel",
        "summary": "Edit, clean, format or enhance an Excel workbook",
        "description": "Opens an existing workbook (or CSV) and applies a list of operations: formatting, cleaning, sorting, formulas, charts, validation, dashboards, sheet management. The original file is never changed; a new file is returned.",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "source",
                "operations"
              ],
              "properties": {
                "source": {
                  "type": "object",
                  "title": "Source workbook",
                  "description": "The existing file. Provide fileBase64 (base64 text of the .xlsx/.xlsm/.csv) OR fileUrl (a public direct-download link; private SharePoint/OneDrive links do not work).",
                  "properties": {
                    "fileBase64": {
                      "type": "string",
                      "description": "Base64 content of the workbook"
                    },
                    "fileUrl": {
                      "type": "string",
                      "description": "Public direct-download URL"
                    },
                    "fileName": {
                      "type": "string",
                      "description": "Original file name incl. extension, e.g. budget.xlsx"
                    }
                  }
                },
                "operations": {
                  "type": "array",
                  "x-ms-summary": "Operations",
                  "items": {
                    "type": "object"
                  },
                  "description": "Ordered list of {op, sheet, ...} objects (max 80). Examples: {op:'enhance_sheet',sheet:'Orders'}, {op:'clean_data',sheet:'Orders',actions:['trim','text_to_numbers','text_to_dates','remove_blank_rows','dedupe']}, {op:'add_formula_column',sheet:'Orders',header:'Margin',formula:'=[@Profit]/[@Revenue]',format:'percent'}, {op:'conditional_format',sheet:'Orders',column:'Status',rule:{type:'status',map:{Done:'green',Late:'red'}}}, {op:'validate_data',sheet:'Orders',rules:[{column:'Email',type:'email',required:true}]}, {op:'auto_dashboard',sheet:'Orders'}. Call GetExcelCapabilities for all operations."
                },
                "fileName": {
                  "type": "string",
                  "x-ms-summary": "Output file name"
                },
                "theme": {
                  "type": "string",
                  "x-ms-summary": "Theme",
                  "default": "vkollab"
                },
                "currency": {
                  "type": "string",
                  "x-ms-summary": "Currency",
                  "default": "USD"
                },
                "continueOnError": {
                  "type": "boolean",
                  "x-ms-summary": "Continue on error",
                  "description": "Skip failing operations instead of stopping",
                  "default": false
                },
                "returnBase64": {
                  "type": "boolean",
                  "x-ms-summary": "Return file content",
                  "default": false
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
