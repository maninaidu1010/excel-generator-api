                      "type": "string",
                      "description": "Base64 content of the workbook"
                    },
                    "fileUrl": {
                      "type": "string",
                      "description": "Public direct-download URL"
                    },
                    "fileName": {
                      "type": "string",
                      "description": "Original file name incl. extension, e.g. budget.xlsx"
                    }
                  }
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string"
                },
                "fileName": {
                  "type": "string"
                },
                "healthScore": {
                  "type": "integer",
                  "description": "0-100 data and formula health"
                },
                "summary": {
                  "type": "object",
                  "description": "Counts of errors, warnings and info items"
                },
                "issues": {
                  "type": "array",
