{
  "swagger": "2.0",
  "info": {
    "title": "Excel Generator Connector",
    "description": "Create, edit, format, enhance, validate and analyze Excel workbooks.",
    "version": "1.0"
  },
  "host": "excel-generator-api.onrender.com",
  "basePath": "/",
  "schemes": [
    "https"
