  "editexcel_clean_and_enhance": {
    "source": {
      "fileBase64": "<BASE64>",
      "fileName": "orders.xlsx"
    },
    "fileName": "Orders-clean",
    "operations": [
      {
        "op": "find_replace",
        "sheet": "Orders",
        "find": "done",
        "replace": "Done",
        "wholeCell": true
      },
      {
        "op": "clean_data",
        "sheet": "Orders",
        "actions": [
          "trim",
          "collapse_spaces",
          "text_to_numbers",
          "text_to_dates",
          "remove_blank_rows",
          "dedupe",
          "proper_case"
        ],
        "columns": [
          "Region"
        ],
        "keys": [
          "Order ID",
          "Product",
          "Qty"
        ]
      },
      {
        "op": "clean_data",
        "sheet": "Orders",
        "actions": [
          "text_to_numbers",
          "text_to_dates"
        ]
      },
      {
        "op": "enhance_sheet",
        "sheet": "Orders"
      },
      {
        "op": "conditional_format",
        "sheet": "Orders",
        "column": "Status",
        "rule": {
          "type": "status",
          "map": {
            "Done": "green",
            "Late": "red",
            "Pending": "amber"
          }
        }
      },
      {
        "op": "conditional_format",
        "sheet": "Orders",
        "column": "Total",
        "rule": {
          "type": "dataBar"
        }
      },
      {
        "op": "data_validation",
        "sheet": "Orders",
        "column": "Status",
        "rule": {
          "type": "list",
          "values": [
            "Done",
            "Late",
            "Pending"
          ],
          "error": "Pick a status from the list"
        }
      },
      {
        "op": "data_validation",
        "sheet": "Orders",
        "column": "Qty",
        "rule": {
          "type": "whole",
          "min": 1,
          "max": 500
        }
      },
      {
        "op": "add_formula_column",
        "sheet": "Orders",
        "header": "Discounted",
        "formula": "=[@Total]*0.9",
        "format": "currency"
      },
      {
        "op": "add_totals_row",
        "sheet": "Orders",
        "columns": {
          "Qty": "sum",
          "Total": "sum"
        }
      },
      {
        "op": "validate_data",
        "sheet": "Orders",
        "rules": [
          {
            "column": "Email",
            "type": "email",
            "required": true
          },
          {
            "column": "Order ID",
            "unique": true
          },
          {
            "column": "Qty",
            "type": "integer",
            "min": 1,
            "max": 25
          }
        ]
      },
      {
        "op": "freeze_panes",
        "sheet": "Orders",
        "cell": "A2"
      },
      {
        "op": "auto_dashboard",
        "sheet": "Orders",
        "name": "Dashboard"
      },
      {
        "op": "page_setup",
        "sheet": "Orders",
        "orientation": "landscape",
        "printTitleRows": "1:1",
        "footer": "Page &P of &N"
      }
    ]
  },
  "editexcel_quick_polish": {
    "source": {
