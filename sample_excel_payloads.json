        "sheet": "Sheet1"
      },
      {
        "op": "auto_dashboard",
        "sheet": "Sheet1"
      }
    ]
  },
  "analyzeexcel": {
    "source": {
      "fileBase64": "<BASE64>",
      "fileName": "orders.xlsx"
    }
  }
}