            "2026-10-02",
            "Travel",
            "Cab to client site",
            1850,
            "Anita"
          ],
          [
            "2026-10-05",
            "Software",
            "Design licence",
            12000,
            "Ravi"
          ],
          [
            "2026-10-09",
            "Meals",
            "Team lunch",
            4600,
            "Sita"
          ]
        ],
        "columns": [
          {
            "header": "Amount",
            "total": "sum",
            "format": "currency0",
